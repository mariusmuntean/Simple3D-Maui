<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Diagnostic counters and fault-injection hooks for the gallery's native GPU probes. Packed Release builds omit them. -->
  <PropertyGroup Condition="'$(EnableNativeRenderProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_RENDER_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only diagnostic builds of the gallery (native GPU probes) may use internals; packed Release builds keep the sample on the public API. -->
    <InternalsVisibleTo Include="Simple3D.Demo" Condition="'$(Configuration)' == 'Debug' or '$(EnableNativeRenderProbe)' == 'true'" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
    <ProjectReference Include="../Simple3D.Core/Simple3D.Core.csproj" />
    <None Include="../../docs/PACKAGE-README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../assets/brand/package-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
