<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Simple3D.Core.Tests" />
    <InternalsVisibleTo Include="Simple3D.Gpu.Tests" />
    <InternalsVisibleTo Include="Simple3D.Maui" />
    <!-- Only diagnostic builds of the gallery (native GPU probes) may use internals; packed Release builds keep the sample on the public API. -->
    <InternalsVisibleTo Include="Simple3D.Demo" Condition="'$(Configuration)' == 'Debug' or '$(EnableNativeRenderProbe)' == 'true'" />
    <InternalsVisibleTo Include="Simple3D.Maui.Tests" />
    <None Include="../../docs/PACKAGE-README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../assets/brand/package-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
