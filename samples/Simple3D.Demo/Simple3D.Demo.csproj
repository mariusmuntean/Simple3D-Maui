<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>Simple3D Gallery</ApplicationTitle>
    <_AppBundleName Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">$(AssemblyName)</_AppBundleName>
    <ApplicationId>dev.simple3d.gallery</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <!-- The Mac Catalyst workload (27.0.x) rejects Xcode 27.1; remove once a 27.1 workload ships. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableNativeRenderProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_RENDER_PROBE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-android'">
    <!-- Android supports JIT compilation; avoid interpreting the per-pixel rendering loops. -->
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and ('$(TargetFramework)' == 'net10.0-ios' or '$(TargetFramework)' == 'net10.0-maccatalyst')">
    <!-- Compile the rendering libraries; retain interpreter support for the demo UI. -->
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>-all,Simple3D.Demo</MtouchInterpreter>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!-- The accurate model holds full-body tracking far better than the base model (see docs/DEVELOPMENT.md). -->
    <PackageReference Include="Xamarin.Google.MLKit.PoseDetection.Accurate" Version="117.0.0.23" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.5.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.5.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.5.2.1" />
    <!-- The multiplatform Compose annotation package pulls its JVM jar next to the Android aar; D8 rejects the duplicate classes. -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
    <ProjectReference Include="../../src/Simple3D.Maui/Simple3D.Maui.csproj" />
    <Compile Include="../Simple3D.Shared/**/*.cs" Link="Samples/%(Filename)%(Extension)" />
    <Compile Include="../../tests/Shared/NativeGpuValidation.cs" Link="Diagnostics/NativeGpuValidation.cs" Condition="'$(EnableNativeRenderProbe)' == 'true' or '$(Configuration)' == 'Debug'" />
    <Compile Include="../../tests/Shared/AppearancePerformanceProbe.cs" Link="Diagnostics/AppearancePerformanceProbe.cs" Condition="'$(EnableNativeRenderProbe)' == 'true' or '$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#101A2D" />
    <!-- The Mirror scene's characters: 100Avatars "Froggy" by Polygonal Mind and "Chubby Tubby Cat" by ToxSam (both CC0). -->
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#101A2D" BaseSize="128,128" />
  </ItemGroup>
</Project>
