<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-android;net10.0-maccatalyst</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ValidationVersion Condition="'$(ValidationVersion)' == ''">0.0.0-validation</ValidationVersion>
    <RestoreAdditionalProjectSources>$(PackageFeed)</RestoreAdditionalProjectSources>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Simple3D.Maui" Version="$(ValidationVersion)" />
  </ItemGroup>
</Project>
