    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Simple3D.Core/Simple3D.Core.csproj" />
    <Compile Include="../../src/Simple3D.Maui/Rendering/GpuFrame.cs" Link="GpuFrame.cs" />
    <Compile Include="../../src/Simple3D.Maui/Rendering/Gles.cs" Link="Gles.cs" />
    <Compile Include="../../src/Simple3D.Maui/Rendering/GlesRenderer.cs" Link="GlesRenderer.cs" />
    <Compile Include="../../samples/Simple3D.Shared/*.cs" Link="Samples/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
