<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ValidationVersion Condition="'$(ValidationVersion)' == ''">0.0.0-validation</ValidationVersion>
    <RestoreSources Condition="'$(PackageFeed)' != ''">$(PackageFeed)</RestoreSources>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Simple3D.Core" Version="$(ValidationVersion)" />
  </ItemGroup>
</Project>
