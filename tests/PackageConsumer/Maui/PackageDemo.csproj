<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Apple targets need macOS and Xcode; elsewhere only Android builds. Pack on macOS to ship all three. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Simple3D.Demo</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ApplicationTitle>Simple3D Package Check</ApplicationTitle>
    <ApplicationId>dev.simple3d.packagecheck</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- The library's own floors, so the package is checked on the oldest systems it claims. -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">17.0</SupportedOSPlatformVersion>
    <_AppBundleName Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">$(AssemblyName)</_AppBundleName>
  </PropertyGroup>
  <!-- Simulator and Mac Catalyst builds sign ad hoc unless a signing key is given, so they need no certificate.
       Device builds still take -p:CodesignKey and -p:CodesignProvision. -->
  <PropertyGroup Condition="'$(CodesignKey)' == '' and ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' or ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and !$(RuntimeIdentifier.StartsWith('ios-'))))">
    <EnableCodeSigning>true</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Simple3D.Maui" Version="0.3.0-preview.1" />
    <!-- ConsumerMauiVersion checks the package against an older MAUI, e.g. the library's minimum. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$([MSBuild]::ValueOrDefault('$(ConsumerMauiVersion)', '$(MauiVersion)'))" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#101A2D" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#101A2D" BaseSize="128,128" />
  </ItemGroup>
</Project>
