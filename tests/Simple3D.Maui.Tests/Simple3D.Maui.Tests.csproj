<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiTestVersion)" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="$(SkiaSharpVersion)" />
    <ProjectReference Include="../../src/Simple3D.Core/Simple3D.Core.csproj" />
    <Compile Include="../../src/Simple3D.Maui/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/Simple3D.Maui/Rendering/*.cs" Link="Rendering/%(Filename)%(Extension)" />
    <Compile Include="../../samples/Simple3D.Shared/**/*.cs" Link="Samples/%(Filename)%(Extension)" />
    <Compile Include="../../samples/Simple3D.Demo/GalleryPage.cs" Link="GalleryPage.cs" />
    <Compile Include="../../samples/Simple3D.Demo/SceneViewer.cs" Link="SceneViewer.cs" />
    <Compile Include="../../samples/Simple3D.Demo/SceneCatalog.cs" Link="SceneCatalog.cs" />
    <Compile Include="../../samples/Simple3D.Demo/Renderer.cs" Link="Renderer.cs" />
    <Compile Include="../../samples/Simple3D.Demo/Controls.cs" Link="Controls.cs" />
    <Compile Include="../../samples/Simple3D.Demo/Icons.cs" Link="Icons.cs" />
    <Compile Include="../../samples/Simple3D.Demo/Theme.cs" Link="Theme.cs" />
    <Compile Include="../../samples/Simple3D.Demo/App.cs" Link="App.cs" />
    <Compile Include="../../samples/Simple3D.Demo/NativeRenderProbe.cs" Link="NativeRenderProbe.cs" />
    <Compile Include="../Shared/RegressionScenes.cs" Link="RegressionScenes.cs" />
    <None Include="../../samples/Simple3D.Demo/Resources/Raw/*.vrm" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/**" Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/AppearancePerformanceProbe.cs" Link="AppearancePerformanceProbe.cs" />
  </ItemGroup>
</Project>
