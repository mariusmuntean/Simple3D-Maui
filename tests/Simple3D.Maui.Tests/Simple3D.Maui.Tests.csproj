<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <ProjectReference Include="../../src/Simple3D.Core/Simple3D.Core.csproj" />
    <Compile Include="../../src/Simple3D.Maui/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/Simple3D.Maui/Rendering/*.cs" Link="Rendering/%(Filename)%(Extension)" />
    <Compile Include="../../samples/Simple3D.Shared/**/*.cs" Link="Samples/%(Filename)%(Extension)" />
    <Compile Include="../../samples/Simple3D.Demo/GalleryPage.cs" Link="GalleryPage.cs" />
    <Compile Include="../../samples/Simple3D.Demo/App.cs" Link="App.cs" />
    <Compile Include="../../samples/Simple3D.Demo/NativeRenderProbe.cs" Link="NativeRenderProbe.cs" />
    <Compile Include="../Shared/RegressionScenes.cs" Link="RegressionScenes.cs" />
    <None Include="../../samples/Simple3D.Demo/Resources/Raw/froggy.vrm" Link="Assets/froggy.vrm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/**" Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/AppearancePerformanceProbe.cs" Link="AppearancePerformanceProbe.cs" />
  </ItemGroup>
</Project>
